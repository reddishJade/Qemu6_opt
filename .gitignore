# QEMU source tree: track all source, ignore only build products.

# In-tree build directories (e.g. build_ret/, build_hyperchain/)
/build*/
/build/

# Compiler / linker artifacts
*.o
*.a
*.lo
*.la
*.d
*.gcda
*.gcno
*.gcov
*.so
*.dylib
*.dll
*.exe

# Generated configuration and build-system files
config-host.mak
config-host.h
config-target.mak
config-target.h
config.status
config.log
config-po.mak
build.ninja
meson-private/
meson-logs/
meson-info/
*.stamp
*.stamp-*
po/*.gmo

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Local / generated files not part of the QEMU source tree
config-temp/
.git-submodule-status
.gdbinit
changelog
committed_changes.zip

# Checked-out submodule contents (not part of this source repository)
/roms/
/capstone/
/dtc/
/slirp/

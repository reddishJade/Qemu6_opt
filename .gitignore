# 忽略所有内容
*

# 不忽略 .gitignore 本身
!.gitignore

# 源代码和文档文件夹
!accel/
!include/
!target/
!tcg/
!linux-user/

# 所有内容不忽略
!accel/**
!include/**
!target/**
!tcg/**
!linux-user/**

# 构建和配置文件
!configure
!Makefile
!GNUmakefile
!meson.build
!meson_options.txt
!Kconfig
!Kconfig.host
!config.sh
!git_version.sh

# CI/CD和项目配置
!.cirrus.yml
!.travis.yml
!.patchew.yml
!.readthedocs.yml
!.editorconfig
!.dir-locals.el
!.exrc
!.mailmap
!gitdm.config

# 源代码文件
!*.c
!*.h
!*.hx
!VERSION
!version.rc
!trace-events
!qemu.nsi
!qemu.sasl

# 格式化配置文件
.clang-format

# AI指示
!AGENTS.md
!CLAUDE.md

# 文档
!.doc/
!.doc/**

# GOT 间接跳转优化验证脚本
!scripts/
scripts/*
!scripts/got-opt-measure.sh
